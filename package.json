{
  "name": "api-rest-nodejs",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "knex": "node --no-warnings --import tsx ./node_modules/.bin/knex",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --env-file=.env.test --no-warnings --import tsx --test --test-reporter=spec \"test/**/*.spec.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^26.6.5",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "dotenv": "^18.0.6",
    "fastify": "^5.12.5",
    "knex": "^3.3.0",
    "sqlite3": "^6.0.1",
    "zod": "^4.6.5"
  }
}
